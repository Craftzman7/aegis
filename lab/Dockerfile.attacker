# LAB ONLY. Attacker container for the Aegis test lab. Runs the attack simulations
# from lab/attacks/ via `docker compose exec`. It has no agent.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      hydra sshpass openssh-client netcat-openbsd curl python3 procps ca-certificates \
 && rm -rf /var/lib/apt/lists/*
